# ==============================================================
# ANDIJON MAZZA — BIZNES VA SAVDO PLATFORMASI CONFIG
# ==============================================================

# 1. DATABASE (PostgreSQL)
# Masalan: postgresql://postgres:password@localhost:5432/andijon_mazza?schema=public
# Bulutli: Supabase / Neon / Render PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/andijon_mazza?schema=public"

# 2. TELEGRAM BOT INTEGRATION
# @BotFather orqali olingan token
TELEGRAM_BOT_TOKEN="123456789:ABCDefghIJKlmnoPQRstuvWXyz"

# Operator yoki Admin guruhining Telegram Chat ID raqami
TELEGRAM_ADMIN_CHAT_ID="-1001234567890"

# Telegram webhook xavfsizlik maxfiy so'zi (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET="super-secret-random-token-here"

# 3. SAYT VA DOMEN
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 4. ADMIN VA XAVFSIZLIK
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="hash_or_secure_secret"
JWT_SECRET="strong-secret-key-for-jwt-sessions-mazza-2026"

# 5. GEOLOKATSIYA VA BIZNES SOZLAMALARI
RESTAURANT_NAME="ANDIJON MAZZA"
BASE_PRICE_PER_KG="80000"
FREE_DELIVERY_MAX_KM="1.0"
FREE_DELIVERY_MIN_KG="10.0"
PRICE_PER_KM="3000"
RESTAURANT_LAT="40.7821"
RESTAURANT_LNG="72.3442"
