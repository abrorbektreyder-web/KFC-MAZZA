datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrderType {
  PICKUP
  DELIVERY
  EVENT
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  OPERATOR_CONFIRMED
  CLICK
  PAYME
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AdminRole {
  SUPER_ADMIN
  MANAGER
  OPERATOR
}

model Admin {
  id           String      @id @default(uuid())
  username     String      @unique
  passwordHash String
  fullName     String
  role         AdminRole   @default(OPERATOR)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  auditLogs    AuditLog[]

  @@map("admins")
}

model Customer {
  id             String    @id @default(uuid())
  phoneNumber    String    @unique
  fullName       String
  telegramChatId BigInt?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  orders         Order[]

  @@index([phoneNumber])
  @@map("customers")
}

model Product {
  id             String      @id @default(uuid())
  slug           String      @unique
  nameUz         String
  nameRu         String?
  description    String
  basePricePerKg Decimal     @db.Decimal(12, 2)
  isSpicy        Boolean     @default(false)
  isAvailable    Boolean     @default(true)
  imageUrl       String
  model3dUrl     String?
  badgeText      String?
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]

  @@map("products")
}

model Order {
  id                 String               @id @default(uuid())
  orderNumber        String               @unique // Masalan: #ORD-2026-0001
  customerId         String
  customer           Customer             @relation(fields: [customerId], references: [id])
  orderType          OrderType            @default(DELIVERY)
  status             OrderStatus          @default(NEW)
  paymentMethod      PaymentMethod        @default(CASH)
  paymentStatus      PaymentStatus        @default(PENDING)
  
  // Moliyaviy hisob-kitoblar (Serverda hisoblanadi)
  itemsTotal         Decimal              @db.Decimal(12, 2)
  deliveryFee        Decimal              @default(0.00) @db.Decimal(12, 2)
  discountAmount     Decimal              @default(0.00) @db.Decimal(12, 2)
  grandTotal         Decimal              @db.Decimal(12, 2)
  totalWeightKg      Decimal              @db.Decimal(6, 2)

  // Yetkazish va lokatsiya
  deliveryAddress    String?
  deliveryLatitude   Float?
  deliveryLongitude  Float?
  distanceKm         Float?
  
  // Tadbir/Ehson qo'shimcha parametrlari
  eventDate          DateTime?
  guestCount         Int?
  customerNotes      String?
  operatorNotes      String?
  
  // Metadata & Idempotency
  sourceChannel      String               @default("WEB") // WEB, TELEGRAM_BOT, TELEGRAM_MINI_APP
  idempotencyKey     String?              @unique

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  payments           Payment[]

  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  weightKg       Decimal  @db.Decimal(6, 2)
  unitPricePerKg Decimal  @db.Decimal(12, 2)
  totalPrice     Decimal  @db.Decimal(12, 2)
  flavorNotes    String?

  @@map("order_items")
}

model OrderStatusHistory {
  id         String      @id @default(uuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  changedBy  String      // "SYSTEM", "ADMIN:username", "TELEGRAM:chatId"
  comment    String?
  createdAt  DateTime    @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

model DeliveryZone {
  id             String   @id @default(uuid())
  name           String
  baseDistanceKm Float    @default(1.0)
  freeWeightKg   Float    @default(10.0)
  basePrice      Decimal  @default(0.00) @db.Decimal(12, 2)
  pricePerKm     Decimal  @default(3000.00) @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("delivery_zones")
}

model BusinessSetting {
  id                String   @id @default("default")
  restaurantName    String   @default("ANDIJON MAZZA")
  contactPhone      String   @default("+998901234567")
  telegramUsername  String   @default("@andijon_mazza_bot")
  isOpen            Boolean  @default(true)
  openTime          String   @default("10:00")
  closeTime         String   @default("23:00")
  pickupAddressUz   String   @default("Andijon tumani, Markaziy ko'cha 15-uy")
  pickupLatitude    Float    @default(40.7821)
  pickupLongitude   Float    @default(72.3442)
  updatedAt         DateTime @updatedAt

  @@map("business_settings")
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String?
  admin      Admin?   @relation(fields: [adminId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  transactionId String?
  payload       Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("payments")
}
